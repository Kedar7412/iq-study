# IQ Study environment variables
# Copy this file to .env.local and fill in values for local development.

# OpenAI API key. Optional.
# When empty/unset, the app falls back to the deterministic mock AI provider,
# so build, tests, and dev all work without any real key.
OPENAI_API_KEY=

# AI provider selection: "openai" | "mock".
# Defaults to "mock" when no OPENAI_API_KEY is present.
LLM_PROVIDER=mock

# OpenAI model to use when LLM_PROVIDER=openai. Optional (defaults to gpt-4o-mini).
OPENAI_MODEL=

# Secret used for signing user sessions. Use a long random string in real deployments.
AUTH_SECRET=

# Supabase persistence. Optional for local dev / CI / preview.
# When BOTH SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, the book, user, and
# review stores persist durably to hosted Supabase Postgres. When either is empty/unset,
# the app automatically falls back to the in-memory store, so build, tests, and dev all
# work keyless. All database access is server-side; do NOT add NEXT_PUBLIC_* client vars.
SUPABASE_URL=https://yuukqpmxaxsqewpgjlbu.supabase.co

# service_role key from the Supabase dashboard -> Project Settings -> API -> service_role key.
# This is a SECRET: it bypasses row-level security. NEVER expose it to the client and NEVER
# commit it. Leave blank here; set it only in your deployment's environment variables.
SUPABASE_SERVICE_ROLE_KEY=
